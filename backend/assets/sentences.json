[
  {
    "dura": "म्हिकारे ङिनि उनिजो",
    "nepali": "सबैलाई मेरो नमस्कार"
  },
  {
    "dura": "थोनो एँग् छिँउ पो।",
    "nepali": "आज अति जाडो छ।"
  },
  {
    "dura": "हादे टाङा उपोजु ले?",
    "nepali": "के काम गरेको हो?"
  },
  {
    "dura": "मामि मिकि।",
    "nepali": "घाम छैन।"
  },
  {
    "dura": "टाङा मिकि नामि।",
    "nepali": "काम छैन भने"
  },
  {
    "dura": "ङिरु लाउँधोजे तोन्।",
    "nepali": "हाम्रो घरमा आऊ।"
  },
  {
    "dura": "ज्याबे बाजार् ङ्याइनि।",
    "nepali": "संगै बजार जाउला।"
  },
  {
    "dura": "हयानामि मो मो ताठिपोजु ज्याइनि।",
    "nepali": "होइनभने मः मः बनाएर खाउँला।"
  },
  {
    "dura": "नाकारुनि स्या पातान् तो।",
    "nepali": "कुखुराको मासु लेऊ है।"
  },
  {
    "dura": "झिम्कुमा लापोजु थिंइनि।",
    "nepali": "दुई जना भएर पकाउँला।"
  },
  {
    "dura": "जेनाजनि आम्लाउँधो ङ्याबो।",
    "nepali": "केटाकेटी स्कुल गयो।"
  },
  {
    "dura": "बेका आफिस ङ्याबो।",
    "nepali": "बूढा अफिस गयो।"
  },
  {
    "dura": "याकुला जे तोबो।",
    "nepali": "साँझमा आयो।"
  },
  {
    "dura": "हादे टाङा उते?",
    "nepali": "के काम गर्ने?"
  },
  {
    "dura": "ङि युँ नानि लाउँधो तोइनि।",
    "nepali": "म पनि तिम्रो घर आउँला।"
  },
  {
    "dura": "कोभो नामि पाउँ लिसो तोदो।",
    "nepali": "कहिले भने भोलि पर्सि आउँछु।"
  },
  {
    "dura": "ङिफि नारे म्रा उपोजु पो तो।",
    "nepali": "मैले तिमीलाई निम्ता गरेको छु है।"
  },
  {
    "dura": "खारा घिँपोजु पो।",
    "nepali": "नुन सकिएको छ।"
  },
  {
    "dura": "खारा युँ तापान् तो।",
    "nepali": "नुन पनि लेऊ है।"
  },
  {
    "dura": "नुजा युँ मिकि।",
    "nepali": "तेल पनि छैन।"
  },
  {
    "dura": "आम्रोफि टेइनि ह्यापेन्।",
    "nepali": "मास्टरले कुट्ला नबोल्।"
  },
  {
    "dura": "रिम्सि जेबो?",
    "nepali": "कुरा बुझ्यौ?"
  },
  {
    "dura": "नामे झिम् लाकासा रो छान्।",
    "nepali": "एक दुई शब्द त भन।"
  },
  {
    "dura": "खिन्चि थाङ् ले ।",
    "nepali": "धेरै उकालो रहेछ।"
  },
  {
    "dura": "रिंजाफि उछिनि।",
    "nepali": "अरुले उछिन्ला ।"
  },
  {
    "dura": "हादेइ(कुदि) लाइनि?",
    "nepali": "कसो होला?"
  },
  {
    "dura": "ले रो?",
    "nepali": "हो त?"
  },
  {
    "dura": "ले छेँ।",
    "nepali": "हो नि।"
  },
  {
    "dura": "आसा छ।",
    "nepali": "ब्लो पो।"
  },
  {
    "dura": "सिन् न्हयाबो?",
    "nepali": "भारी पुग्यो?"
  },
  {
    "dura": "नाफि बाबो?",
    "nepali": "तैँले जानिस्?"
  },
  {
    "dura": "याला तोन्।",
    "nepali": "यता आइजा"
  },
  {
    "dura": "ङिरे यु ह्योन्।",
    "nepali": "मलाई नि देउ।"
  },
  {
    "dura": "नाम् भो म्हिन् तो।",
    "nepali": "एक छिन पर्खे है।"
  },
  {
    "dura": "ति(डि) ह्योन् रो।",
    "nepali": "पानि ले त।"
  },
  {
    "dura": "लादो चु ह्याले?",
    "nepali": "हुन्छ कि हुन्न।"
  },
  {
    "dura": "रेँ न्यापादो।",
    "nepali": "छोराले कमाछ।"
  },
  {
    "dura": "हाइहोङ् ह्याले।",
    "nepali": "त्यसरी होइन।"
  },
  {
    "dura": "डास्लिपो ठान्मान्।",
    "nepali": "काखे बानी।"
  },
  {
    "dura": "ग्याउसो तोपोजु मिकि।",
    "nepali": "कर्मी आएको छैन।"
  },
  {
    "dura": "कुर्ङा ह्योन्।",
    "nepali": "कनिका देऊ।"
  },
  {
    "dura": "भ्राँचा ह्योन्।",
    "nepali": "काइयो देऊ।"
  },
  {
    "dura": "ङि यु जादिते तोपोजु।",
    "nepali": "म पनि सुत्न आको।"
  },
  {
    "dura": "हादे यु?",
    "nepali": "के रे?"
  },
  {
    "dura": "प्लोबो प्लोबो।",
    "nepali": "थाक्यो थाक्यो।"
  },
  {
    "dura": "राम्दा उएँ।",
    "nepali": "सहयोग गरौँ।"
  },
  {
    "dura": "खिपि ल्यान्।",
    "nepali": "रोटी पोल्।"
  },
  {
    "dura": "ङिनि ग्याङ् जे।",
    "nepali": "मेरो बिचारमा।"
  },
  {
    "dura": "ङिरे ताखारोन्।",
    "nepali": "मलाई सिकाइ दिनु।"
  },
  {
    "dura": "ठाम्सा कुदु पो?",
    "nepali": "धारा कत्रो छ?"
  },
  {
    "dura": "सुइ लाम्थो तोपोजु?",
    "nepali": "कुन बाटो आको?"
  },
  {
    "dura": "खोतो ताकादो?",
    "nepali": "बस्तुभाउ पाल्छ।"
  },
  {
    "dura": "खिन्चि कुम्ति ह्याह्योन्।",
    "nepali": "धेरै दुख नदेऊ।"
  },
  {
    "dura": "निसि जे हुनुन्।",
    "nepali": "पिढीमा बस।"
  },
  {
    "dura": "ह्याकुर्दानो भिदाबो।",
    "nepali": "नरमाइलो लाग्यो।"
  },
  {
    "dura": "फिंजु म्यापान्जि तोन्।",
    "nepali": "ढोका थुनेर आइज।"
  },
  {
    "dura": "सिमारु रो तिरिसाआपा कोन् पो।",
    "nepali": "बन त रुखै रुख अनकन्टार छ।"
  },
  {
    "dura": "याला मिकि।",
    "nepali": "यहाँ छैन।"
  },
  {
    "dura": "कायु यु रिम् फि कुम्पि ह्योपोजु पो।",
    "nepali": "मुसा र छुचुन्द्रोले दुख दिएको छ।"
  },
  {
    "dura": "निसि पार्।",
    "nepali": "तगारो लगाउ।"
  },
  {
    "dura": "स्वो पार्।",
    "nepali": "चापी लागाउ।"
  },
  {
    "dura": "नुजा मिकि माइखु।",
    "nepali": "तेल छैन आमा।"
  },
  {
    "dura": "मिकि नामि लाबो।",
    "nepali": "छैन भने भयो।"
  },
  {
    "dura": "ङि ङ्याएँ तो।",
    "nepali": "म जाउँ है।"
  },
  {
    "dura": "मातिला धिंबो?",
    "nepali": "मेला सकियो?"
  },
  {
    "dura": "ब्रे तोबो।",
    "nepali": "पाहुना आयो।"
  },
  {
    "dura": "माइ रे काति ह्योबो?",
    "nepali": "भैँसीलाई कुडोपानी दियो?"
  },
  {
    "dura": "सोर्मे भिदाबो।",
    "nepali": "रुघा लाग्यो।"
  },
  {
    "dura": "च्याफि फि चेबो।",
    "nepali": "लाम्खुट्टेले टोक्यो।"
  },
  {
    "dura": "टिकि जेने लोपोजु?",
    "nepali": "कति जान्ने भाको?"
  },
  {
    "dura": "टिकि दाकुसिम्चानो ले?",
    "nepali": "कति बैमानी हो।"
  },
  {
    "dura": "टिकि सिम्चानो पो।",
    "nepali": "कति इमानी रहेछ।"
  },
  {
    "dura": "च्युँ पो?",
    "nepali": "सन्चै छ?"
  },
  {
    "dura": "ति मिकि लाउँधो जे।",
    "nepali": "पानि छैन घरमा।"
  },
  {
    "dura": "हाइँ रो ल्हिनो पो।",
    "nepali": "ऊ त पाउनी(गर्भावती) रहेछ।"
  },
  {
    "dura": "मोमो तोन् तो।",
    "nepali": "सुटुक्क आइज है।"
  },
  {
    "dura": "म्हिकिते ङ्याएँ हो।",
    "nepali": "खेल्न जाउँ है।"
  },
  {
    "dura": "हुनुन् हुनुन्।",
    "nepali": "बस बस।"
  },
  {
    "dura": "टिकि जेङिति तोपोजु?",
    "nepali": "कति पसिना आको?"
  },
  {
    "dura": "यातोङ् ले।",
    "nepali": "यस्तै हो।"
  }
]